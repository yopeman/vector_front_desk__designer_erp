{
  "expo": {
    "name": "Vector ERP",
    "slug": "vector-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vector-logo.jpg",
    "scheme": "vectorerp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/vector-logo.jpg",
        "backgroundImage": "./assets/vector-logo.jpg",
        "monochromeImage": "./assets/vector-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vector.erp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/vector-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/vector-logo.jpg",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb49d38c-ffdb-432f-8d38-7b5d05b74f53"
      }
    },
    "owner": "j16912031"
  }
}
